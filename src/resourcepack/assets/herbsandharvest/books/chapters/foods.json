	  {
		  "type": "standard",
		  
		  "title": "herbsandharvest.guide_book.foods.dairy.milk.got_milk",

		  "summary": "怎么挤奶：\n\n和挤牛奶一样，对山羊用空桶得到山羊奶，对绵羊用空桶得到绵羊奶。 ",

		  "elements": [			

			  {
				  "type": "text",
				  "literal_text": "要取骆驼奶，对骆驼潜行右键空桶。\n\n注意：这可能会打开骆驼的物品栏或让你骑上去，但奶照样能取到。",
				  "text": null
			  }
		  ]
	  },
	  
	  {
		  "type": "standard",
		  
		  "title": "herbsandharvest.guide_book.foods.dairy.cream",

		  "summary": "奶油要在加热的炼药锅里熬。",

		  "elements": [			
				{
				  "type": "text",
				  "literal_text": "\n",
				  "text": null
				},


				{
					"type": "icon_list",
					"entries": [
				 
						{
							"item": "herbsandharvest:cream_bucket",
