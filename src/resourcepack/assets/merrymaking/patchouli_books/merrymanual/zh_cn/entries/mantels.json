          "C": "merrymaking:oak_mantel[facing=west,section=2,type=garland,stocking=true]",
          "D": "merrymaking:oak_mantel[corner=true,facing=west,section=3,type=garland,stocking=true]",
          "E": "merrymaking:oak_mantel[facing=west,section=4,type=garland]"
        },
        "pattern": [
